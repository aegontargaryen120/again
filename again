#!/opt/homebrew/bin/python3.15
import subprocess as sub
from subprocess import DEVNULL
from pathlib import Path
import shutil
import sys
sys.path.append(str(Path(__file__).resolve().parent.parent))
from name import name as dir_name

COMMANDS = {
    "git": "The main command for git stuff.",
    "git help": "This command prints the help for all git subcommands.",
    "git create": "Takes in name, public/not, description, and creates the repo for you. \033[1;35mNOTE:\033[0m This uses 'gh' command line tool.",
    "git push": "Automates 'git add', 'git commit', 'git push'. Takes in commit message and set upstream/not.",
    "git setup": "Automates starting files. Takes in language for .gitignore, repo name for README.md",
    "python": "The main command for python stuff",
    "python help": "Prints python help message",
    "python clean": "Deletes __pycache__/ directory"
}

def print_help() -> None:
    print("Available commands are:")
    for cmd in COMMANDS:
        print(f"{cmd}:\t\t{COMMANDS[cmd]}")


def python_help(cmd: str | None = None) -> int:
    if not cmd:
        print("\thelp:\t\tPrints this help")
        print("\tclean:\t\tDeletes the python-generated `__pycache__` directory")

    else:
        if "python " + cmd in COMMANDS:
            if cmd == "help":
                print("I know you know how to use help. Look at you doing it now!")
                
            elif cmd == "clean":
                print("Arguments:\n\t\tNone")
                print("Syntax (example):\n\t\tpython clean")

            else:
                print(f"No such subcommand or help not implemented: {cmd}")
                return 1

    return 0


def python_clean() -> int:
    result = sub.run(["rm", "-rf", "__pycache__"], stdout=DEVNULL)

    if result.returncode != 0:
        return 1
    else:
        return 0


def git_help(cmd: str = None) -> int:
    if not cmd:
        print("\thelp:\t\tPrints this help.")
        print("\tcreate:\t\tTakes in name, public/not, description, and creates the repo for you.\033[1;35mNOTE:\033[0m This uses 'gh' command line tool.")
        print("\tpush:\t\tTakes in commit message and upstream/not automatically pushes source code to the repo.")  
        print("\tsetup:\t\tTakes in language for .gitignore, name for README.md and writes all starting files.")

        return 0

    else:
        if "git " + cmd in COMMANDS:
            if cmd == "create":
                print("Arguments:")
                print("\tName:\t\tName of repo")
                print("\tPublic:\t\tDecides if creating private repo, or public repo.")
                print("\tDescription:\t\tAdds description of repo.")
                print("")
                print("Syntax (example):")
                print("\tgit create repo_name [ public / private ] Description of the repo")

            elif cmd == "push":
                print("Arguments:")
                print("\tSet upstream:\t\tDecides whether to uses -u or not")
                print("\tCommit Message:\t\tSets the commit message")
                print("")
                print("Syntax (example):")
                print("\tgit push [ upstream / set ] Commit message")

            elif cmd == "setup":
                print("Arguments:")
                print("\tLanguage:\t\tSets language for .gitignore template")
                print("\tRepo Name:\t\tBasic README template.")
                print("")
                print("Syntax (example):")
                print("\tgit setup [ python / cxx ] REPO_NAME")

            elif cmd == "help":
                print("Nice try. You know how to use help!")

            else:
                print(f"No such subcommand or help not implemented: {cmd}")
                return 1

        else:
            print(f"No such subcommand: {cmd}")
            return 1

    return 0


def git_create(name: str, public: bool, description: str) -> int:
    command = ["gh", "repo", "create", name]

    if public:
        command.append("--public")
    else:
        command.append("--private")

    if description:
        command.append("--description")
        command.append(description)
    else:
        print("\033[1;31mERROR:\033[0m\tCommand requires description!")
        return 1

    result = sub.run(
        command,
        stdout=DEVNULL
    )

    if result.returncode == 0:
        return 0
    else:
        return 1

    return 0


def git_push(message: str, upstream: bool) -> int:
    add = sub.run(["git", "add", "."], stdout=DEVNULL)
    if add.returncode != 0:
        return 1

    commit = ["git", "commit"]
    if message:
        commit.append("-m")
        commit.append(message)
    else:
        print("Command requires commit message!")
        return 1
    commit_cmd = sub.run(commit, stdout=DEVNULL)
    if commit_cmd.returncode != 0:
        return 1

    push = ["git", "push"]
    if upstream == False:
        push.append("-u")
        push.append("origin")
        push.append("main")
    else:
        pass
    push_cmd = sub.run(push, stdout=DEVNULL)
    if push_cmd.returncode != 0:
        return 1
    
    return 0


def git_setup(lang: str, name: str) -> int:
    result = sub.run(["touch", "README.md", ".gitignore", ".gitattributes"], stdout=DEVNULL)
    if result.returncode != 0:
        return 1

    if name:
        with open("README.md", "w") as f:
            f.write(f"# {name}\n")
    else:
        print("Command requires name!")
        return 1

    if lang:
        with open(".gitignore", "w") as f:
            if lang == "python":
                f.write("# python gitignore\n")
                f.write("*.pyc\n")
                f.write("**/*.pyc\n")
                f.write("__pycache__/*\n")
                f.write("**/__pycache__/*\n")
                f.write("__pycache__/\n")
                f.write("**/__pycache__/\n")
            elif lang == "cxx":
                f.write("# c/c++ gitignore\n")
                f.write("*.bin\n")
                f.write("*.o\n")
            else:
                print(f"Sorry! {lang} is not supported as of now!")
                return 1
    else:
        print("Command requires lang!")
        return 1

    with open(".gitattributes", "w") as f:
        f.write("*.* text eol=lf\n")

    shutil.copy(Path("/Users") / dir_name / "code" / "LICENSE.txt", "./")

    return 0


def dispatch(cmd_unsplit: str) -> int:
    cmd = cmd_unsplit.split()

    try:
        if cmd[0] == "git":
            if cmd[1] == "help":
                if len(cmd) > 2:
                    return git_help(cmd[2])
                else:
                    return git_help()
        
            elif cmd[1] == "create":
                name = cmd[2]
                public = True
        
                if cmd[3] == "public":
                    public = True
                elif cmd[3] == "private":
                    public = False
                else:
                    print("Invalid command for public")
                    return 1
                    
                description = " ".join(cmd[4:len(cmd)])
                return git_create(name, public, description)

            elif cmd[1] == "push":
                upstream = True
                if cmd[2] == "upstream":
                    upstream = True
                elif cmd[2] == "set":
                    upstream = False
                else:
                    print("Invalid command for upstream")
                    return 1

                message = ' '.join(cmd[3:len(cmd)])

                return git_push(message, upstream)

            elif cmd[1] == "setup":
                lang = cmd[2]
                name = cmd[3]

                return git_setup(lang, name)

            else:
                print("Invalid subcommand for git: '%s'" % cmd[1])
                return 1

        elif cmd[0] == "help":
            print_help()
            return 0

        elif cmd[0] == "exit":
            return 10

        elif cmd[0] == "python":
            if cmd[1] == "help":
                if len(cmd) > 2:
                    return python_help(cmd[2])
                else:
                    return python_help()
            
            elif cmd[1] == "clean":
                return python_clean()

            else:
                print("Invalid subcommand for python: '%s'" % cmd[1])
                return 1
    
        else:
            print(f"Sorry! '{cmd[0]}' command isn't supported as of now.")
            return 1

    except IndexError:
        print("Empty command.")
        return 1


def main() -> None:
    while True:
        cmd_unsplit = input(">> ").strip()
        exit_code = dispatch(cmd_unsplit)

        if exit_code == 0 or exit_code == 1:
            continue
        else:
            break
    sys.exit(0)


if __name__ == "__main__":
    main()

